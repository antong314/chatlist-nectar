
# API Configuration
VITE_API_URL=https://machu-server-app-2tn7n.ondigitalocean.app

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Machu WhatsApp bot (server-only; never prefix secrets with VITE_)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+15555555555
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
PUBLIC_BASE_URL=https://www.sanmateo.love
TWILIO_WEBHOOK_URL=https://www.sanmateo.love/bot

# Machu group digest (server; off unless ADMIN_WHATSAPP is set)
ADMIN_WHATSAPP=+15555555555
DIGEST_MODE=shadow
DIGEST_OPENAI_MODEL=gpt-6-luna
DIGEST_HOUR=6
DIGEST_TIMEZONE=America/Costa_Rica
DIGEST_TEMPLATE_SID=
DIGEST_SECRET=generate-a-random-32-plus-character-secret

# Machu group listener worker (listener/)
DATABASE_URL=postgresql://machu_listener.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SENDER_HASH_SECRET=generate-a-random-32-plus-character-secret
